{
  "name": "quran-calm-path",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "packages/shared"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:dev": "vite build --mode development",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "setup": "npm install && npm run setup:env",
    "setup:env": "node scripts/setup-env.mjs",
    "kill-ports": "node scripts/kill-ports.js",
    "dev:fresh": "npm run kill-ports && npm run dev"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.0",
  "dependencies": {
    "@tanstack/react-query": "^5.90.12",
    "lovable-tagger": "^1.1.13",
    "lucide-react": "^0.562.0",
    "react-router-dom": "^7.11.0",
    "tailwindcss-animate": "^1.0.7"
  }
}

